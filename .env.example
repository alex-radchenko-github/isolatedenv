# Docker Compose shared environment variables
# Copy to .env and change values before running
# Secrets are auto-generated by the template — see .env after project scaffolding

POSTGRES_PASSWORD=  # Auto-generated. See .env
POSTGRES_DB=my_project
REDIS_PASSWORD=  # Auto-generated. See .env

# Authentik secrets (auto-generated by template)
AUTHENTIK_SECRET_KEY=  # Auto-generated. See .env
AUTHENTIK_BOOTSTRAP_PASSWORD=  # Auto-generated. See .env
AUTHENTIK_BOOTSTRAP_TOKEN=  # Auto-generated. See .env
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_DB_PASSWORD=  # Auto-generated. Separate PostgreSQL password for Authentik

# OIDC / OAuth2 (auto-generated by template)
AUTHENTIK_CLIENT_ID=  # Auto-generated. See .env
AUTHENTIK_CLIENT_SECRET=  # Auto-generated. See .env

# Ports (external mapping — change for parallel projects)
API_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
AUTHENTIK_PORT=9000
