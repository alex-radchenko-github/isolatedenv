# Local development -- docker-compose up -d (DB + Redis), uvicorn on host

# Database (async -- for FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:@localhost:5442/  # auto-generated, see .env
# Database (sync -- for Alembic & Celery)
DATABASE_URL_SYNC=postgresql://postgres:@localhost:5442/  # auto-generated, see .env

# Authentik (OIDC / JWKS)
AUTHENTIK_URL=http://localhost:9010
AUTHENTIK_CLIENT_ID=  # auto-generated, see .env
AUTHENTIK_CLIENT_SECRET=  # auto-generated, see .env
AUTHENTIK_API_TOKEN=  # auto-generated, see .env
JWKS_URL=http://localhost:9010/application/o/isolatedenv/jwks/
OIDC_ISSUER=http://localhost:9010/application/o/isolatedenv/

# Redis
REDIS_URL=redis://:@localhost:6389/0  # auto-generated password, see .env
REDIS_CACHE_URL=redis://:@localhost:6389/1  # auto-generated password, see .env
REDIS_RESULT_URL=redis://:@localhost:6389/3  # auto-generated password, see .env

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3010,http://localhost:5173

# First admin (auto-assigned on first login)
ADMIN_EMAIL=admin@example.com

# Sentry (optional)
SENTRY_DSN=
